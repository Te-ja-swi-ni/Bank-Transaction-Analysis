{
    "name": "Bank Transaction Dark Premium UI",
    "dataColors": [
        "#00C49F",
        "#FFBB28",
        "#FF8042",
        "#0088FE",
        "#8884d8",
        "#ff6b6b",
        "#4ecdc4",
        "#c7f464"
    ],
    "background": "#0D1117",
    "foreground": "#E6EDF3",
    "tableAccent": "#00C49F",
    "visualStyles": {
        "*": {
            "*": {
                "*": [
                    {
                        "responsive": true
                    }
                ],
                "background": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#161B22" } },
                        "transparency": 15
                    }
                ],
                "border": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#30363D" } },
                        "radius": 12
                    }
                ],
                "dropShadow": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#000000" } },
                        "position": "Outer",
                        "size": 5,
                        "angle": 90,
                        "distance": 3,
                        "transparency": 60
                    }
                ],
                "visualHeader": [
                    {
                        "show": false
                    }
                ],
                "visualTooltip": [
                    {
                        "type": "Default",
                        "titleFontColor": { "solid": { "color": "#FFFFFF" } },
                        "valueFontColor": { "solid": { "color": "#E6EDF3" } },
                        "background": { "solid": { "color": "#21262D" } },
                        "transparency": 5
                    }
                ],
                "title": [
                    {
                        "show": true,
                        "fontColor": { "solid": { "color": "#E6EDF3" } },
                        "fontSize": 14,
                        "fontFamily": "Segoe UI Bold, Arial",
                        "alignment": "Center"
                    }
                ]
            }
        },
        "page": {
            "*": {
                "background": [
                    {
                        "color": { "solid": { "color": "#0D1117" } },
                        "transparency": 0
                    }
                ],
                "outspace": [
                    {
                        "color": { "solid": { "color": "#0D1117" } },
                        "transparency": 0
                    }
                ]
            }
        },
        "card": {
            "*": {
                "labels": [
                    {
                        "color": { "solid": { "color": "#00C49F" } },
                        "fontSize": 32,
                        "fontFamily": "Segoe UI Bold"
                    }
                ],
                "categoryLabels": [
                    {
                        "show": true,
                        "fontColor": { "solid": { "color": "#8B949E" } },
                        "fontSize": 12,
                        "fontFamily": "Segoe UI"
                    }
                ]
            }
        },
        "slicer": {
            "*": {
                "header": [
                    {
                        "fontColor": { "solid": { "color": "#E6EDF3" } }
                    }
                ],
                "items": [
                    {
                        "fontColor": { "solid": { "color": "#E6EDF3" } },
                        "background": { "solid": { "color": "#161B22" } }
                    }
                ]
            }
        }
    }
}
